# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# PostgreSQL - if password has @ or : use %40 and %3A
# Example: password "Pass@123" -> postgresql://postgres:Pass%40123@localhost:5432/crowdai
DATABASE_URL=postgresql://postgres:Subhashree%402005@localhost:5432/crowdai

# Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
